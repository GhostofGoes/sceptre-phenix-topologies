#!/bin/bash
# Health of the Wazuh SIEM, for SoH custom tests and SCORCH `cc` checks (DESIGN.md
# 15.4 and 15.6). Installed as /usr/local/sbin/cm-wazuh-health; run it as root on
# the manager. Prints one line, `HEALTHY: ...` or `UNHEALTHY: <reason>`, and exits
# 0 or 1:
#   - the manager, the indexer, Filebeat, and the dashboard are active,
#   - the manager takes agents (1514 and 1515) and syslog (UDP 514), and the
#     dashboard answers on 443,
#   - and the number of agents that report as Active.
# CM_WAZUH_MIN_AGENTS (default 1) is the number of active agents that counts as healthy.
set -uo pipefail

MIN_AGENTS="${CM_WAZUH_MIN_AGENTS:-1}"

fail() {
  echo "UNHEALTHY: $*"
  exit 1
}

for unit in wazuh-manager wazuh-indexer filebeat wazuh-dashboard; do
  systemctl is-active --quiet "${unit}.service" || fail "${unit} is not active"
done
listening=$(ss -Hltun)
for port in tcp:1514 tcp:1515 udp:514 tcp:443 tcp:55000 tcp:9200; do
  grep -Eq "^${port%%:*} .*[:.]${port##*:} " <<< "$listening" || fail "nothing listens on ${port%%:*} ${port##*:}"
done

# agent_control -l prints one line per agent: "ID: 001, Name: ews, IP: any, Active".
active=$(/var/ossec/bin/agent_control -l 2> /dev/null | grep -c ', Active$' || true)
if [ "${active:-0}" -lt "$MIN_AGENTS" ]; then
  fail "${active:-0} active agents, ${MIN_AGENTS} required"
fi
echo "HEALTHY: manager, indexer, Filebeat, and dashboard are up; ${active} agents active"
