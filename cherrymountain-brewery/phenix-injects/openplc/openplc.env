# Settings for cm-openplc-provision on plc-cellar. Range-only credentials: the
# ci variant is a throwaway test range. Production variants get a generated
# secret from the cherrymountain app instead.
OPENPLC_USER=admin
OPENPLC_PASSWORD=cm-ci-openplc-range-only
OPENPLC_PORT=8443
# Compile timeout in seconds (the spike target is under 600).
OPENPLC_COMPILE_TIMEOUT=900
