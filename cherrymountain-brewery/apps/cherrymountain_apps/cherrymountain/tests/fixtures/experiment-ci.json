{
  "apiVersion": "phenix.sandia.gov/v1",
  "kind": "Experiment",
  "metadata": {
    "name": "cherrymountain-ci",
    "annotations": {
      "topology": "cherrymountain-ci",
      "scenario": "cherrymountain-ci"
    }
  },
  "spec": {
    "experimentName": "cherrymountain-ci",
    "baseDir": "/phenix/experiments/cherrymountain-ci",
    "defaultBridge": "cherrymtn",
    "topology": {
      "nodes": [
        {
          "general": {
            "description": "HELICS root broker (started by the helics app); CI has no weather, event API, or ground-truth OpenSearch",
            "hostname": "sim-ctl"
          },
          "labels": {
            "zone": "mgmt"
          },
          "hardware": {
            "drives": [
              {
                "image": "cm-sim.qc2",
                "inject_partition": 1
              }
            ],
            "memory": 2048,
            "os_type": "linux",
            "vcpus": 1
          },
          "network": {
            "interfaces": [
              {
                "address": "172.16.10.1",
                "mask": 16,
                "name": "mgmt",
                "proto": "static",
                "type": "ethernet",
                "vlan": "MGMT"
              }
            ]
          },
          "type": "VirtualMachine"
        },
        {
          "general": {
            "description": "Cellar process federate (HELICS)",
            "hostname": "sim-process"
          },
          "annotations": {
            "helics/federate": [
              {
                "broker": "sim-ctl|mgmt",
                "fed-count": 1
              }
            ]
          },
          "labels": {
            "zone": "mgmt"
          },
          "delay": {
            "c2": [
              {
                "hostname": "sim-ctl",
                "useUUID": false
              }
            ]
          },
          "hardware": {
            "drives": [
              {
                "image": "cm-sim.qc2",
                "inject_partition": 1
              }
            ],
            "memory": 2048,
            "os_type": "linux",
            "vcpus": 2
          },
          "injections": [
            {
              "description": "plantgen HELICS config for the cellar federate",
              "src": "/phenix/injects/${BRANCH_NAME}/sim/helics.json",
              "dst": "/etc/cherrymountain/helics.json",
              "permissions": "0644"
            },
            {
              "description": "cellar federate environment",
              "src": "/phenix/injects/${BRANCH_NAME}/sim/cm-cellar.env",
              "dst": "/etc/default/cm-cellar",
              "permissions": "0644"
            },
            {
              "description": "cellar federate systemd unit",
              "src": "/phenix/injects/${BRANCH_NAME}/sim/cm-cellar.service",
              "dst": "/etc/systemd/system/cm-cellar.service",
              "permissions": "0644"
            },
            {
              "description": "enable the federate once the broker answers",
              "src": "/phenix/injects/${BRANCH_NAME}/sim/60-cm-cellar.sh",
              "dst": "/etc/phenix/startup/60-cm-cellar.sh",
              "permissions": "0755"
            }
          ],
          "network": {
            "interfaces": [
              {
                "address": "172.16.10.2",
                "mask": 16,
                "name": "mgmt",
                "proto": "static",
                "type": "ethernet",
                "vlan": "MGMT"
              }
            ]
          },
          "type": "VirtualMachine"
        },
        {
          "general": {
            "description": "Cellar remote I/O (ot-sim fd-server)",
            "hostname": "rio-cellar"
          },
          "labels": {
            "zone": "field-cel"
          },
          "delay": {
            "c2": [
              {
                "hostname": "sim-ctl",
                "useUUID": false
              }
            ]
          },
          "hardware": {
            "drives": [
              {
                "image": "cm-otsim.qc2",
                "inject_partition": 1
              }
            ],
            "memory": 1024,
            "os_type": "linux",
            "vcpus": 1
          },
          "network": {
            "interfaces": [
              {
                "address": "10.20.12.10",
                "mask": 24,
                "name": "IF0",
                "proto": "static",
                "type": "ethernet",
                "vlan": "FIELD-CEL"
              },
              {
                "address": "172.16.20.12",
                "mask": 16,
                "name": "mgmt",
                "proto": "static",
                "type": "ethernet",
                "vlan": "MGMT"
              }
            ]
          },
          "type": "VirtualMachine"
        },
        {
          "general": {
            "description": "Cellar PLC (OpenPLC v4, modbus_master to rio-cellar and modbus_slave to FUXA)",
            "hostname": "plc-cellar"
          },
          "labels": {
            "zone": "ctrl"
          },
          "delay": {
            "c2": [
              {
                "hostname": "rio-cellar",
                "useUUID": false
              }
            ]
          },
          "hardware": {
            "drives": [
              {
                "image": "cm-openplc.qc2",
                "inject_partition": 1
              }
            ],
            "memory": 1024,
            "os_type": "linux",
            "vcpus": 1
          },
          "injections": [
            {
              "description": "OpenPLC Editor program ZIP (built by the Editor, stored in Git LFS)",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/plc-cellar.zip",
              "dst": "/opt/cherrymountain/openplc/plc-cellar.zip",
              "permissions": "0644"
            },
            {
              "description": "plantgen modbus_master plugin config",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/plc-cellar/conf/modbus_master.json",
              "dst": "/opt/cherrymountain/openplc/conf/modbus_master.json",
              "permissions": "0644"
            },
            {
              "description": "modbus_slave plugin config (northbound, port 502)",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/plc-cellar/conf/modbus_slave.json",
              "dst": "/opt/cherrymountain/openplc/conf/modbus_slave.json",
              "permissions": "0644"
            },
            {
              "description": "provisioning settings",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/openplc.env",
              "dst": "/etc/default/cm-openplc",
              "permissions": "0600"
            },
            {
              "description": "repack, upload, compile, and start the program",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/cm-openplc-provision.sh",
              "dst": "/usr/local/bin/cm-openplc-provision",
              "permissions": "0755"
            },
            {
              "description": "provisioning unit",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/cm-openplc-provision.service",
              "dst": "/etc/systemd/system/cm-openplc-provision.service",
              "permissions": "0644"
            },
            {
              "description": "start provisioning after the network is up",
              "src": "/phenix/injects/${BRANCH_NAME}/openplc/70-openplc-provision.sh",
              "dst": "/etc/phenix/startup/70-openplc-provision.sh",
              "permissions": "0755"
            }
          ],
          "network": {
            "interfaces": [
              {
                "address": "10.20.10.12",
                "mask": 24,
                "name": "IF0",
                "proto": "static",
                "type": "ethernet",
                "vlan": "CTRL"
              },
              {
                "address": "10.20.12.1",
                "mask": 24,
                "name": "IF1",
                "proto": "static",
                "type": "ethernet",
                "vlan": "FIELD-CEL"
              }
            ]
          },
          "type": "VirtualMachine"
        },
        {
          "general": {
            "description": "Process SCADA (FUXA); shares the flat CTRL VLAN with plc-cellar in the ci variant",
            "hostname": "scada-fuxa"
          },
          "annotations": {
            "phenix/startup-autotunnel": [
              "11881:1881"
            ]
          },
          "labels": {
            "zone": "ctrl"
          },
          "delay": {
            "c2": [
              {
                "hostname": "plc-cellar",
                "useUUID": false
              }
            ]
          },
          "hardware": {
            "drives": [
              {
                "image": "cm-fuxa.qc2",
                "inject_partition": 1
              }
            ],
            "memory": 2048,
            "os_type": "linux",
            "vcpus": 2
          },
          "injections": [
            {
              "description": "FUXA settings (secure mode, SQLite DAQ, no Node-RED)",
              "src": "/phenix/injects/${BRANCH_NAME}/fuxa/mysettings.json",
              "dst": "/opt/fuxa/server/_appdata/mysettings.json",
              "permissions": "0600"
            },
            {
              "description": "FUXA project with the plc-cellar device, cellar view, and alarms",
              "src": "/phenix/injects/${BRANCH_NAME}/fuxa/scada-fuxa-project.json",
              "dst": "/etc/cherrymountain/fuxa/project.json",
              "permissions": "0644"
            },
            {
              "description": "provisioning settings",
              "src": "/phenix/injects/${BRANCH_NAME}/fuxa/fuxa.env",
              "dst": "/etc/default/cm-fuxa",
              "permissions": "0600"
            },
            {
              "description": "set the admin password and import the project",
              "src": "/phenix/injects/${BRANCH_NAME}/fuxa/cm-fuxa-provision.sh",
              "dst": "/usr/local/bin/cm-fuxa-provision",
              "permissions": "0755"
            },
            {
              "description": "provisioning unit",
              "src": "/phenix/injects/${BRANCH_NAME}/fuxa/cm-fuxa-provision.service",
              "dst": "/etc/systemd/system/cm-fuxa-provision.service",
              "permissions": "0644"
            },
            {
              "description": "start provisioning after the network is up",
              "src": "/phenix/injects/${BRANCH_NAME}/fuxa/70-fuxa-provision.sh",
              "dst": "/etc/phenix/startup/70-fuxa-provision.sh",
              "permissions": "0755"
            }
          ],
          "network": {
            "interfaces": [
              {
                "address": "10.20.10.10",
                "mask": 24,
                "name": "IF0",
                "proto": "static",
                "type": "ethernet",
                "vlan": "CTRL"
              }
            ]
          },
          "type": "VirtualMachine"
        }
      ]
    },
    "scenario": {
      "apps": [
        {
          "name": "ot-sim",
          "metadata": {
            "infrastructure": "brewery",
            "infrastructures": {
              "brewery": {
                "sim-clock": {
                  "sim_hours": {
                    "type": "analog-read",
                    "modbus": {
                      "data-type": "uint16",
                      "scaling": 1
                    }
                  }
                },
                "fv-zone": {
                  "temp_f": {
                    "type": "analog-read",
                    "modbus": {
                      "data-type": "uint16",
                      "scaling": 2
                    }
                  },
                  "valve": {
                    "type": "binary-read-write"
                  }
                },
                "fv-vessel": {
                  "pressure_psia": {
                    "type": "analog-read",
                    "modbus": {
                      "data-type": "uint16",
                      "scaling": 2
                    }
                  },
                  "gravity_plato": {
                    "type": "analog-read",
                    "modbus": {
                      "data-type": "uint16",
                      "scaling": 2
                    }
                  },
                  "spund_sp_psia": {
                    "type": "analog-read-write",
                    "modbus": {
                      "data-type": "uint16",
                      "scaling": 2
                    }
                  },
                  "spund_open": {
                    "type": "binary-read"
                  }
                }
              }
            },
            "helics": {
              "broker": {
                "hostname": "sim-ctl|mgmt"
              },
              "federate": "cellar",
              "endpoint": "updates",
              "end-time": 86400
            },
            "cpu-module": {
              "api-endpoint": "127.0.0.1:9101"
            }
          },
          "hosts": [
            {
              "hostname": "rio-cellar",
              "metadata": {
                "type": "fd-server",
                "modbus": {
                  "interface": "IF0:502",
                  "devices": [
                    {
                      "name": "cellar/clock",
                      "type": "sim-clock"
                    },
                    {
                      "name": "cellar/fv101-side",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv101-cone",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv101",
                      "type": "fv-vessel"
                    },
                    {
                      "name": "cellar/fv102-side",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv102-cone",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv102",
                      "type": "fv-vessel"
                    },
                    {
                      "name": "cellar/fv103-side",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv103-cone",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv103",
                      "type": "fv-vessel"
                    },
                    {
                      "name": "cellar/fv104-side",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv104-cone",
                      "type": "fv-zone"
                    },
                    {
                      "name": "cellar/fv104",
                      "type": "fv-vessel"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "cherrymountain",
          "metadata": {
            "variant": "ci",
            "verify": {
              "timeout": 15
            }
          },
          "hosts": [
            {
              "hostname": "sim-ctl",
              "metadata": {
                "type": "sim-ctl"
              }
            },
            {
              "hostname": "sim-process",
              "metadata": {
                "type": "sim-federate"
              }
            },
            {
              "hostname": "rio-cellar",
              "metadata": {
                "type": "rio"
              }
            },
            {
              "hostname": "plc-cellar",
              "metadata": {
                "type": "openplc"
              }
            },
            {
              "hostname": "scada-fuxa",
              "metadata": {
                "type": "fuxa"
              }
            }
          ]
        },
        {
          "name": "helics",
          "metadata": {
            "broker": {
              "root": "sim-ctl|mgmt",
              "log-level": "summary",
              "log-dir": "/var/log"
            }
          }
        },
        {
          "name": "ntp",
          "metadata": {
            "defaultSource": {
              "hostname": "sim-ctl",
              "interface": "mgmt"
            }
          },
          "hosts": [
            {
              "hostname": "sim-ctl",
              "metadata": {
                "server": "chronyd"
              }
            },
            {
              "hostname": "sim-process",
              "metadata": {
                "client": "chrony"
              }
            },
            {
              "hostname": "rio-cellar",
              "metadata": {
                "client": "chrony"
              }
            },
            {
              "hostname": "plc-cellar",
              "metadata": {
                "client": "chrony",
                "source": {
                  "hostname": "scada-fuxa",
                  "interface": "IF0"
                }
              }
            },
            {
              "hostname": "scada-fuxa",
              "metadata": {
                "server": "chronyd"
              }
            }
          ]
        },
        {
          "name": "soh",
          "metadata": {
            "startupDelay": "10m",
            "c2Timeout": "15m",
            "testReachability": "off",
            "testCustomReachability": [
              {
                "src": "plc-cellar",
                "dst": "rio-cellar|IF0",
                "proto": "tcp",
                "port": 502,
                "wait": "5m"
              },
              {
                "src": "scada-fuxa",
                "dst": "plc-cellar|IF0",
                "proto": "tcp",
                "port": 502,
                "wait": "5m"
              }
            ],
            "hostProcesses": {
              "rio-cellar": [
                "ot-sim-cpu-module",
                "ot-sim-modbus-module"
              ],
              "scada-fuxa": [
                "/opt/fuxa/server/main.js"
              ],
              "sim-ctl": [
                "helics_broker"
              ],
              "sim-process": [
                "cherrymountain_sim"
              ]
            },
            "hostListeners": {
              "plc-cellar": [
                ":502"
              ],
              "rio-cellar": [
                ":502"
              ],
              "scada-fuxa": [
                ":1881"
              ],
              "sim-ctl": [
                ":23404"
              ]
            },
            "hostCustomTests": {
              "plc-cellar": [
                {
                  "name": "openplc-program-running",
                  "executor": "bash",
                  "testScript": "test -f /var/lib/cm-openplc/provisioned && echo provisioned\n",
                  "testStdout": "provisioned"
                }
              ],
              "scada-fuxa": [
                {
                  "name": "fuxa-project-imported",
                  "executor": "bash",
                  "testScript": "systemctl is-active cm-fuxa-provision.service\n",
                  "testStdout": "active"
                }
              ]
            }
          }
        }
      ]
    },
    "vlans": {
      "aliases": {
        "CTRL": 108,
        "FIELD-CEL": 110,
        "MGMT": 117
      },
      "min": 100,
      "max": 199
    },
    "schedules": {},
    "deployMode": "no-headnode",
    "useGREMesh": false
  },
  "status": {
    "startTime": "",
    "schedules": {},
    "apps": {},
    "vlans": {}
  }
}
