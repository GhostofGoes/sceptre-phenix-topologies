# Malcolm on the sensor VM. The topology injects this file as /etc/default/cm-malcolm.
# systemd reads it as an EnvironmentFile and the scripts source it, so keep it to
# NAME=value lines.

# Sizing profile (DESIGN.md 11): full, slim, or auto. auto picks full on a VM
# with 22 GB of memory or more and slim below that; see profiles.sh.
CM_MALCOLM_PROFILE=auto

# The capture interface: the in-guest Open vSwitch bridge, where the mirror app
# delivers the monitored VLANs, and the GRE port that feeds it.
CM_CAPTURE_IFACE=phenix
CM_SNIFFER_PORT=sniffer

# The admin password of the web UI (user malcolm). The cherrymountain app gives the
# sensor one per experiment in /etc/default/cm-malcolm-credentials (root only, from
# secrets.json malcolm_password), which the provisioning unit reads after this file.
# Without the app, leave it out and the first boot generates one; either way it is in
# /var/lib/cm-malcolm/admin-password (root only). This file is world readable: a
# password set here is for a hand-run lab and is not a secret.
# MALCOLM_ADMIN_PASSWORD=
