+// vyosConfigLines returns the `config` metadata of a router: VyOS
+// configuration commands that the template writes after everything it
+// generates itself, before the commit. Each line is one `set` or `delete`
+// command. The rendered file is a vbash script, so a line may not hold
+// anything the shell would act on outside single quotes.
+func vyosConfigLines(md map[string]any, isVyos bool) ([]string, error) {
+	raw, ok := md["config"]
+	if !ok {
+		return nil, nil
+	}
+
+	if !isVyos {
+		return nil, fmt.Errorf("%w: config is only supported for os_type vyos", ErrVyosConfigLine)
+	}
+
+	var lines []string
+
+	err := mapstructure.Decode(raw, &lines)
+	if err != nil {
+		return nil, fmt.Errorf("decoding config lines: %w", err)
+	}
+
+	for idx, line := range lines {
+		if !strings.HasPrefix(line, "set ") && !strings.HasPrefix(line, "delete ") {
+			return nil, fmt.Errorf("%w: line %d does not start with set or delete", ErrVyosConfigLine, idx)
+		}
+
+		quoted := false
+
+		for _, r := range line {
+			switch {
+			case unicode.IsControl(r):
+				return nil, fmt.Errorf("%w: line %d has a control character", ErrVyosConfigLine, idx)
+			case r == '\'':
+				quoted = !quoted
+			case !quoted && strings.ContainsRune("\"`$;|&<>(){}\\#!*?~", r):
+				return nil, fmt.Errorf(
+					"%w: line %d has %q outside single quotes", ErrVyosConfigLine, idx, r,
+				)
+			}
+		}
+
+		if quoted {
+			return nil, fmt.Errorf("%w: line %d has an unclosed single quote", ErrVyosConfigLine, idx)
+		}
+	}
+
+	return lines, nil
+}
