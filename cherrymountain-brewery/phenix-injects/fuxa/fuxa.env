# Settings for cm-fuxa-provision on scada-fuxa. Range-only credentials: the
# ci variant is a throwaway test range. Production variants get a generated
# secret from the cherrymountain app instead.
FUXA_URL=http://127.0.0.1:1881
# FUXA seeds an admin account with this password. FUXA has no admin-password
# setting, so the script changes it through the users API.
FUXA_SEED_PASSWORD=123456
FUXA_ADMIN_PASSWORD=cm-ci-fuxa-range-only
FUXA_PROJECT=/etc/cherrymountain/fuxa/project.json
