(*
  plc-cellar: CherryMountain Brewery cellar PLC, full and lite variants
  (DESIGN.md 6.3, 6.7, 12.1). The ci slice runs plc-cellar.st instead.

  Per fermenter FV-101 .. FV-104:
    - on/off glycol valve control with a 0.5 degF hysteresis half band on the
      side and cone zones (cooling only)
    - the spunding setpoint: 1 psig while the beer is fermenting, 12 psig once
      the apparent extract falls below 5 degP (near terminal gravity), written
      to the RIO as absolute pressure every scan
  Per bright tank BBT-201 and BBT-202:
    - jacket glycol valve on/off control
    - the equilibrium head pressure for the carbonation target at the
      temperature setpoint (Zahm-Nagel fit, sea-level gauge plus 14.7 psi =
      absolute; the setpoint, not the measured temperature, so the limit does
      not swing with the glycol hysteresis), and carbonation-stone flow
      proportional to the shortfall in dissolved CO2, closed while the head is
      more than HEAD_MARGIN above that pressure or at HEAD_MAX (0.5 psi under
      the 26.1 psia high-pressure alarm), so neither that alarm nor the 15 psig
      relief valve trips in normal running. A target whose equilibrium is above
      HEAD_MAX - HEAD_MARGIN cannot be reached, so AT01.SP is clamped to the
      most that can (VOL_MAX, solved from the same fit), and the HMI shows it.
    - BBT-202 feeds the bottling line: its outlet opens while it holds beer
  Shared equipment:
    - the cellar CO2 life-safety interlock (DESIGN.md 6.7): CEL.SYS.XS01.CO2_OK
      is the hardwired, de-energize-to-trip relay from bas-vent. While it is
      open, and for CO2_RELEASE_DELAY after it closes again, the program sets
      CO2_INHIBIT, closes both carbonation valves, and closes the hop-port CO2
      purge (holding a dry-hop sequence in its purge step). No supervisory host
      takes part. The relay reads open until the building federate first
      reports it, so carbonation starts inhibited.
    - the dry-hop sequence on an operator request: CO2 purge, then dose
    - the transfer and CIP peer status bits that plc-utilities reads
    - confined-space entry (29 CFR 1910.146, DESIGN.md 6.3): a vessel's entry
      permit bit locks out its glycol valves, the bright tanks' carbonation
      stone and outlet, and (through plc-utilities) its CIP circuit, vents a
      fermenter's head through its spunding valve, holds the dry-hop doser
      while any fermenter is entered, and latches a critical alarm when a
      locked-out output is found written between scans
  Alarms (every bit in alarms.json for this PLC) are generated by
  plc/common/plcbuild.py at the ALARMS marker, with their deadbands and delays.

  Units: analog values are raw registers, engineering value x 10^scaling
  (degF x 100, psia x 100, vol x 100, % x 10). Setpoints in %MW belong to the
  operator after the first scan; the program loads defaults once and clamps.
*)

(* One glycol zone: cooling-only on/off valve with hysteresis. *)
FUNCTION_BLOCK GlycolZone
  VAR_INPUT
    PV : UINT;                 (* temperature, degF x 100 *)
    SP : UINT;                 (* setpoint, degF x 100 *)
    HYST : UINT := 50;         (* half band, 0.5 degF *)
  END_VAR
  VAR_OUTPUT
    VALVE : BOOL;              (* TRUE = open (cooling) *)
  END_VAR
  IF PV >= SP + HYST THEN
    VALVE := TRUE;
  ELSIF PV + HYST <= SP THEN
    VALVE := FALSE;
  END_IF;
END_FUNCTION_BLOCK

(* Carbonation for one bright tank. *)
FUNCTION_BLOCK Carbonation
  VAR_INPUT
    TEMP_SP : UINT;            (* temperature setpoint, degF x 100 *)
    VOL_SP : UINT;             (* target, vol x 100 *)
    VOL_PV : UINT;             (* inline meter, vol x 100 *)
    PSIA_PV : UINT;            (* head pressure, psia x 100 *)
    INHIBIT : BOOL;            (* cellar CO2 interlock *)
    HEAD_MARGIN : UINT := 50;  (* stone closes 0.5 psi above equilibrium, psi x 100 *)
    HEAD_MAX : UINT := 2560;   (* and never above 25.6 psia, psia x 100 *)
  END_VAR
  VAR_OUTPUT
    PSIA_SP : UINT;            (* equilibrium head pressure, psia x 100 *)
    VALVE : UINT;              (* stone flow valve, % x 10 *)
    VOL_MAX : UINT;            (* most reachable under HEAD_MAX, vol x 100 *)
  END_VAR
  VAR
    temp_f : REAL;
    vol : REAL;
    psig_sea_level : REAL;
    shortfall : REAL;
    qa : REAL;
    qb : REAL;
    qc : REAL;
  END_VAR
  temp_f := UINT_TO_REAL(TEMP_SP) / 100.0;
  (* The fit is quadratic in vol: qa vol^2 + qb vol + qc = 0 at the highest
     equilibrium the stone may build to (HEAD_MAX - HEAD_MARGIN). *)
  qa := -0.0684226;
  qb := 4.24267 + 0.173354 * temp_f;
  qc := -16.6999 - 0.0101059 * temp_f + 0.00116512 * temp_f * temp_f
    - (UINT_TO_REAL(HEAD_MAX - HEAD_MARGIN) / 100.0 - 14.7);
  VOL_MAX := REAL_TO_UINT(LIMIT(0.0,
    (SQRT(qb * qb - 4.0 * qa * qc) - qb) / (2.0 * qa) * 100.0, 500.0));
  vol := UINT_TO_REAL(MIN(VOL_SP, VOL_MAX)) / 100.0;
  psig_sea_level := -16.6999 - 0.0101059 * temp_f + 0.00116512 * temp_f * temp_f
    + 0.173354 * temp_f * vol + 4.24267 * vol - 0.0684226 * vol * vol;
  PSIA_SP := REAL_TO_UINT(LIMIT(0.0, (psig_sea_level + 14.7) * 100.0, 4000.0));
  (* 100 % at 0.5 vol or more short of the target, closed at the target. *)
  shortfall := vol - UINT_TO_REAL(VOL_PV) / 100.0;
  IF INHIBIT OR shortfall <= 0.0 OR PSIA_PV >= MIN(PSIA_SP + HEAD_MARGIN, HEAD_MAX) THEN
    VALVE := 0;
  ELSE
    VALVE := REAL_TO_UINT(LIMIT(0.0, shortfall * 2000.0, 1000.0));
  END_IF;
END_FUNCTION_BLOCK

PROGRAM plc_cellar
  (* LOCATED_VARS: plcbuild.py splices the located variables and alarm instances here. *)

  VAR CONSTANT
    TEMP_SP_MIN : UINT := 2000;       (* 20 degF *)
    TEMP_SP_MAX : UINT := 9000;       (* 90 degF *)
    VOL_SP_MAX : UINT := 350;         (* 3.5 vol *)
    AMBIENT_PSIA : UINT := 1210;      (* 12.1 psia at 5,200 ft *)
    SPUND_LOW_PSIG : UINT := 100;     (* 1 psig while fermenting *)
    SPUND_HIGH_PSIG : UINT := 1200;   (* 12 psig near terminal gravity *)
    TERMINAL_PLATO : UINT := 500;     (* 5 degP *)
    BBT_FEED_MIN_LEVEL : UINT := 50;  (* 5 % *)
    CO2_RELEASE_DELAY : TIME := T#60s;  (* relay must be healthy this long *)
    DH_PURGE_TIME : TIME := T#30s;      (* hop-port CO2 purge before a dose *)
    DH_DOSE_TIME : TIME := T#60s;       (* dose valve open *)
  END_VAR

  VAR
    started : BOOL := FALSE;
    fv101_side : GlycolZone;
    fv101_cone : GlycolZone;
    fv102_side : GlycolZone;
    fv102_cone : GlycolZone;
    fv103_side : GlycolZone;
    fv103_cone : GlycolZone;
    fv104_side : GlycolZone;
    fv104_cone : GlycolZone;
    bbt201_zone : GlycolZone;
    bbt202_zone : GlycolZone;
    bbt201_carb : Carbonation;
    bbt202_carb : Carbonation;
    co2_healthy : TON;
    transfer_active : BOOL;
    dh_step : INT := 0;
    dh_purge : TON;
    dh_dose : TON;
    fv_entry : BOOL;
  END_VAR

  (* First scan: default setpoints for the staggered initial state (DESIGN.md 9.4). *)
  IF NOT started THEN
    CEL_FV101_TT01_SP := 6600;
    CEL_FV101_TT02_SP := 6600;
    CEL_FV102_TT01_SP := 6600;
    CEL_FV102_TT02_SP := 6600;
    CEL_FV103_TT01_SP := 6800;
    CEL_FV103_TT02_SP := 6800;
    CEL_FV104_TT01_SP := 3400;
    CEL_FV104_TT02_SP := 3400;
    CEL_BBT201_TT01_SP := 3400;
    CEL_BBT202_TT01_SP := 3400;
    CEL_BBT201_AT01_SP := 260;
    CEL_BBT202_AT01_SP := 260;
    started := TRUE;
  END_IF;

  CEL_FV101_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV101_TT01_SP, TEMP_SP_MAX);
  CEL_FV101_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV101_TT02_SP, TEMP_SP_MAX);
  CEL_FV102_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV102_TT01_SP, TEMP_SP_MAX);
  CEL_FV102_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV102_TT02_SP, TEMP_SP_MAX);
  CEL_FV103_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV103_TT01_SP, TEMP_SP_MAX);
  CEL_FV103_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV103_TT02_SP, TEMP_SP_MAX);
  CEL_FV104_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV104_TT01_SP, TEMP_SP_MAX);
  CEL_FV104_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV104_TT02_SP, TEMP_SP_MAX);
  CEL_BBT201_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_BBT201_TT01_SP, TEMP_SP_MAX);
  CEL_BBT202_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_BBT202_TT01_SP, TEMP_SP_MAX);
  CEL_BBT201_AT01_SP := MIN(CEL_BBT201_AT01_SP, VOL_SP_MAX);
  CEL_BBT202_AT01_SP := MIN(CEL_BBT202_AT01_SP, VOL_SP_MAX);


  (* ---- confined-space entry (29 CFR 1910.146, DESIGN.md 6.3) ------------------ *)
  (* The entry supervisor sets HSnn.ENTRY when the permit is issued. The program
     leaves every locked-out output off at the end of a scan, so a locked output
     that is on at the top of this one was written in between (an HMI, the EWS,
     or an attacker on the PLC's Modbus server): XAnn latches until the entry
     ends. *)
  CEL_ENTRY_XA01_PV := CEL_ENTRY_XS01_LOCKED
    AND (CEL_ENTRY_XA01_PV OR CEL_FV101_TV01_CMD OR CEL_FV101_TV02_CMD);
  CEL_ENTRY_XA02_PV := CEL_ENTRY_XS02_LOCKED
    AND (CEL_ENTRY_XA02_PV OR CEL_FV102_TV01_CMD OR CEL_FV102_TV02_CMD);
  CEL_ENTRY_XA03_PV := CEL_ENTRY_XS03_LOCKED
    AND (CEL_ENTRY_XA03_PV OR CEL_FV103_TV01_CMD OR CEL_FV103_TV02_CMD);
  CEL_ENTRY_XA04_PV := CEL_ENTRY_XS04_LOCKED
    AND (CEL_ENTRY_XA04_PV OR CEL_FV104_TV01_CMD OR CEL_FV104_TV02_CMD);
  CEL_ENTRY_XA05_PV := CEL_ENTRY_XS05_LOCKED
    AND (CEL_ENTRY_XA05_PV OR CEL_BBT201_TV01_CMD OR CEL_BBT201_XV01_CMD OR CEL_BBT201_FCV01_OUT > 0);
  CEL_ENTRY_XA06_PV := CEL_ENTRY_XS06_LOCKED
    AND (CEL_ENTRY_XA06_PV OR CEL_BBT202_TV01_CMD OR CEL_BBT202_XV01_CMD OR CEL_BBT202_FCV01_OUT > 0);
  CEL_ENTRY_XS01_LOCKED := CEL_ENTRY_HS01_ENTRY;
  CEL_ENTRY_XS11_CIP_OK := NOT CEL_ENTRY_XS01_LOCKED;
  CEL_ENTRY_XS02_LOCKED := CEL_ENTRY_HS02_ENTRY;
  CEL_ENTRY_XS12_CIP_OK := NOT CEL_ENTRY_XS02_LOCKED;
  CEL_ENTRY_XS03_LOCKED := CEL_ENTRY_HS03_ENTRY;
  CEL_ENTRY_XS13_CIP_OK := NOT CEL_ENTRY_XS03_LOCKED;
  CEL_ENTRY_XS04_LOCKED := CEL_ENTRY_HS04_ENTRY;
  CEL_ENTRY_XS14_CIP_OK := NOT CEL_ENTRY_XS04_LOCKED;
  CEL_ENTRY_XS05_LOCKED := CEL_ENTRY_HS05_ENTRY;
  CEL_ENTRY_XS15_CIP_OK := NOT CEL_ENTRY_XS05_LOCKED;
  CEL_ENTRY_XS06_LOCKED := CEL_ENTRY_HS06_ENTRY;
  CEL_ENTRY_XS16_CIP_OK := NOT CEL_ENTRY_XS06_LOCKED;
  fv_entry := CEL_ENTRY_XS01_LOCKED OR CEL_ENTRY_XS02_LOCKED
    OR CEL_ENTRY_XS03_LOCKED OR CEL_ENTRY_XS04_LOCKED;

  (* ---- CO2 life-safety interlock (DESIGN.md 6.7) ---------------------------- *)
  (* The relay is de-energize to trip: open (FALSE) inhibits at once, and the
     inhibit clears only after the relay has been healthy for CO2_RELEASE_DELAY. *)
  co2_healthy(IN := CEL_SYS_XS01_CO2_OK, PT := CO2_RELEASE_DELAY);
  CEL_SYS_XS01_CO2_INHIBIT := NOT co2_healthy.Q;

  (* ---- fermenters --------------------------------------------------------------- *)
  fv101_side(PV := CEL_FV101_TT01_PV, SP := CEL_FV101_TT01_SP);
  CEL_FV101_TV01_CMD := fv101_side.VALVE;
  fv101_cone(PV := CEL_FV101_TT02_PV, SP := CEL_FV101_TT02_SP);
  CEL_FV101_TV02_CMD := fv101_cone.VALVE;
  IF CEL_FV101_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV101_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV101_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  fv102_side(PV := CEL_FV102_TT01_PV, SP := CEL_FV102_TT01_SP);
  CEL_FV102_TV01_CMD := fv102_side.VALVE;
  fv102_cone(PV := CEL_FV102_TT02_PV, SP := CEL_FV102_TT02_SP);
  CEL_FV102_TV02_CMD := fv102_cone.VALVE;
  IF CEL_FV102_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV102_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV102_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  fv103_side(PV := CEL_FV103_TT01_PV, SP := CEL_FV103_TT01_SP);
  CEL_FV103_TV01_CMD := fv103_side.VALVE;
  fv103_cone(PV := CEL_FV103_TT02_PV, SP := CEL_FV103_TT02_SP);
  CEL_FV103_TV02_CMD := fv103_cone.VALVE;
  IF CEL_FV103_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV103_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV103_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  fv104_side(PV := CEL_FV104_TT01_PV, SP := CEL_FV104_TT01_SP);
  CEL_FV104_TV01_CMD := fv104_side.VALVE;
  fv104_cone(PV := CEL_FV104_TT02_PV, SP := CEL_FV104_TT02_SP);
  CEL_FV104_TV02_CMD := fv104_cone.VALVE;
  IF CEL_FV104_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV104_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV104_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  (* ---- bright tanks --------------------------------------------------------------- *)
  bbt201_zone(PV := CEL_BBT201_TT01_PV, SP := CEL_BBT201_TT01_SP);
  CEL_BBT201_TV01_CMD := bbt201_zone.VALVE;
  bbt201_carb(TEMP_SP := CEL_BBT201_TT01_SP, VOL_SP := CEL_BBT201_AT01_SP,
    VOL_PV := CEL_BBT201_AT01_PV, PSIA_PV := CEL_BBT201_PT01_PV,
    INHIBIT := CEL_SYS_XS01_CO2_INHIBIT);
  CEL_BBT201_PT01_SP := bbt201_carb.PSIA_SP;
  CEL_BBT201_AT01_SP := MIN(CEL_BBT201_AT01_SP, bbt201_carb.VOL_MAX);
  CEL_BBT201_FCV01_OUT := bbt201_carb.VALVE;
  CEL_BBT201_XV01_CMD := FALSE;  (* BBT-201 is carbonating, not feeding *)

  bbt202_zone(PV := CEL_BBT202_TT01_PV, SP := CEL_BBT202_TT01_SP);
  CEL_BBT202_TV01_CMD := bbt202_zone.VALVE;
  bbt202_carb(TEMP_SP := CEL_BBT202_TT01_SP, VOL_SP := CEL_BBT202_AT01_SP,
    VOL_PV := CEL_BBT202_AT01_PV, PSIA_PV := CEL_BBT202_PT01_PV,
    INHIBIT := CEL_SYS_XS01_CO2_INHIBIT);
  CEL_BBT202_PT01_SP := bbt202_carb.PSIA_SP;
  CEL_BBT202_AT01_SP := MIN(CEL_BBT202_AT01_SP, bbt202_carb.VOL_MAX);
  CEL_BBT202_FCV01_OUT := bbt202_carb.VALVE;
  CEL_BBT202_XV01_CMD := CEL_BBT202_LT01_PV > BBT_FEED_MIN_LEVEL;

  (* ---- entry lockout: glycol, carbonation CO2, and outlet off; the fermenter's
     head vented through its spunding valve (setpoint at ambient, 0 psig). -- *)
  IF CEL_ENTRY_XS01_LOCKED THEN
    CEL_FV101_TV01_CMD := FALSE;
    CEL_FV101_TV02_CMD := FALSE;
    CEL_FV101_PCV01_SP := AMBIENT_PSIA;
  END_IF;
  IF CEL_ENTRY_XS02_LOCKED THEN
    CEL_FV102_TV01_CMD := FALSE;
    CEL_FV102_TV02_CMD := FALSE;
    CEL_FV102_PCV01_SP := AMBIENT_PSIA;
  END_IF;
  IF CEL_ENTRY_XS03_LOCKED THEN
    CEL_FV103_TV01_CMD := FALSE;
    CEL_FV103_TV02_CMD := FALSE;
    CEL_FV103_PCV01_SP := AMBIENT_PSIA;
  END_IF;
  IF CEL_ENTRY_XS04_LOCKED THEN
    CEL_FV104_TV01_CMD := FALSE;
    CEL_FV104_TV02_CMD := FALSE;
    CEL_FV104_PCV01_SP := AMBIENT_PSIA;
  END_IF;
  IF CEL_ENTRY_XS05_LOCKED THEN
    CEL_BBT201_TV01_CMD := FALSE;
    CEL_BBT201_XV01_CMD := FALSE;
    CEL_BBT201_FCV01_OUT := 0;
  END_IF;
  IF CEL_ENTRY_XS06_LOCKED THEN
    CEL_BBT202_TV01_CMD := FALSE;
    CEL_BBT202_XV01_CMD := FALSE;
    CEL_BBT202_FCV01_OUT := 0;
  END_IF;

  (* ---- dry-hop doser (DESIGN.md 6.3): the operator sets the dose request
     (CEL.DH.XC01.CMD); the PLC purges the hop port with CO2 for DH_PURGE_TIME,
     doses for DH_DOSE_TIME, and clears the request. The CO2 interlock closes the
     purge and holds the sequence (the purge timer restarts) while it is set, so
     no CO2 goes into a cellar that is already at tier 2 (DESIGN.md 6.7). *)
  CASE dh_step OF
    0:
      IF CEL_DH_XC01_CMD AND NOT fv_entry THEN
        dh_step := 1;
      END_IF;
    1:
      IF NOT CEL_DH_XC01_CMD THEN
        dh_step := 0;  (* the operator withdrew the request *)
      ELSIF dh_purge.Q THEN
        dh_step := 2;
      END_IF;
    2:
      IF dh_dose.Q THEN
        dh_step := 0;
        CEL_DH_XC01_CMD := FALSE;
      END_IF;
  ELSE
    dh_step := 0;
  END_CASE;
  CEL_DH_XV01_CMD := (dh_step = 1) AND NOT CEL_SYS_XS01_CO2_INHIBIT AND NOT fv_entry;
  dh_purge(IN := CEL_DH_XV01_CMD, PT := DH_PURGE_TIME);
  CEL_DH_XV02_CMD := dh_step = 2 AND NOT fv_entry;
  dh_dose(IN := CEL_DH_XV02_CMD, PT := DH_DOSE_TIME);
  CEL_DH_XS01_STEP := INT_TO_UINT(dh_step);

  (* ---- transfer panel and the peer status for plc-utilities (DESIGN.md 6.6 #4) *)
  CEL_XFER_HS01_CMD := FALSE;
  transfer_active := CEL_XFER_YS01_PV OR CEL_XFER_HS01_CMD;
  CEL_XFER_XS01_ACTIVE := transfer_active;
  CEL_XFER_XS02_CIP_PERMIT := NOT transfer_active;

  (* ALARMS: plcbuild.py generates the alarm logic here. *)
END_PROGRAM
