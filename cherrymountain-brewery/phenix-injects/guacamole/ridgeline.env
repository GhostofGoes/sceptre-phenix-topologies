# The vendor persona of the range: Ridgeline Process Controls' technicians
# (DESIGN.md 13), each with a named account instead of a shared vendor login.
# The topology injects this one file, mode 0600, into three nodes:
#   dmz-jump   cm_vendor_sql.py creates each technician's Guacamole account, TOTP key,
#              and own copies of the EWS connections
#   ews        70-ews-vendor.sh creates each technician's local EWS account
#   vendor-ws  cm_vendor_session.py, the first technician's scripted session (VENDOR_*)
# so the three always agree.
#
# These committed values are a fallback only: the cherrymountain app renders this
# file per experiment (new passwords and TOTP key, DESIGN.md 13) and its injection
# replaces this one on all three nodes. They are used only when the topology runs
# without the app, and protect nothing outside the range. TOTP is a standard RFC 6238 secret (SHA-1, 6 digits, 30 s), so any
# authenticator works with it; the key is in Base32 as Guacamole stores it.
VENDOR_GUAC_USER=ridgeline-akim
VENDOR_GUAC_PASSWORD=gJHAq34hz8CyJp0yDyqx
VENDOR_TOTP_SECRET=RMGFDVN4ZSH7L25OBR6RMUAC4EE4E4X3
VENDOR_EWS_USER=ridgeline-akim
VENDOR_EWS_PASSWORD=8Svpky0Ai66gxqonkFYz
VENDOR_TECH_COUNT=2
VENDOR_TECH1_USER=ridgeline-akim
VENDOR_TECH1_GUAC_PASSWORD=gJHAq34hz8CyJp0yDyqx
VENDOR_TECH1_TOTP_SECRET=RMGFDVN4ZSH7L25OBR6RMUAC4EE4E4X3
VENDOR_TECH1_EWS_PASSWORD=8Svpky0Ai66gxqonkFYz
VENDOR_TECH2_USER=ridgeline-jdiaz
