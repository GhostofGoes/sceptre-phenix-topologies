# Settings for cm-bbmd.service on bas-bbmd, the BAS BBMD (DESIGN.md 10.4).
# Its prefix is the BAS subnet's /24, so it hears the devices' broadcasts and
# rebroadcasts the forwarded Who-Is on the BAS subnet.
CM_BBMD_NAME=bbmd-bas
CM_BBMD_INSTANCE=9002
CM_BBMD_ADDRESS=10.30.10.5/24:47808
CM_BBMD_BDT=10.20.30.13:47808,10.30.10.5:47808
