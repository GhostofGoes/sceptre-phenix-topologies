# The network sensor of a site (docs/multisite/PLANS.md 4.6). plantgen writes a copy
# of this file for each site that has a sensor, and the site's topology injects that
# copy as /etc/default/cm-sensor. systemd reads it as an EnvironmentFile and the
# scripts source it, so keep it to NAME=value lines. No node injects this file
# itself: it names no sensor.

# The sensor's name at Malcolm (Arkime's node name), and its own address. Malcolm's
# Arkime asks that address for the packets of a session (8005/tcp).
CM_SENSOR_NAME=
CM_SENSOR_ADDRESS=

# The fleet's one Malcolm, at the head office. The sensor sends its logs to
# Logstash there (5044/tcp) and its Arkime sessions to OpenSearch (9200/tcp). An
# address and not a name, so that an upload needs no name server.
CM_MALCOLM_HOST=10.40.10.10

# The interface that the mirror app adds has no name here: cm-sensor-acl takes
# only GRE (the taps) on every interface that is not the one with
# CM_SENSOR_ADDRESS and not Docker's. The capture port is the in-guest bridge
# `phenix` with its GRE port `sniffer`, the defaults of cm-malcolm-capture, which
# the sensor shares with malcolm.
