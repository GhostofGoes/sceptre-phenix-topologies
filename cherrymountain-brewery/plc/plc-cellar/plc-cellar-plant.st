(*
  plc-cellar: CherryMountain Brewery cellar PLC, full and lite variants
  (DESIGN.md 6.3, 6.7, 12.1). The ci slice runs plc-cellar.st instead.

  Per fermenter FV-101 .. FV-104:
    - on/off glycol valve control with a 0.5 degF hysteresis half band on the
      side and cone zones (cooling only)
    - the spunding setpoint: 1 psig while the beer is fermenting, 12 psig once
      the apparent extract falls below 5 degP (near terminal gravity), written
      to the RIO as absolute pressure every scan
  Per bright tank BBT-201 and BBT-202:
    - jacket glycol valve on/off control
    - the equilibrium head pressure for the carbonation target (Zahm-Nagel fit,
      sea-level gauge plus 14.7 psi = absolute), and carbonation-stone flow
      proportional to the shortfall in dissolved CO2
    - BBT-202 feeds the bottling line: its outlet opens while it holds beer
  Shared equipment:
    - the cellar CO2 life-safety interlock (DESIGN.md 6.7): CEL.SYS.XS01.CO2_OK
      is the hardwired, de-energize-to-trip relay from bas-vent. While it is
      open, and for CO2_RELEASE_DELAY after it closes again, the program sets
      CO2_INHIBIT, closes both carbonation valves, and keeps the hop-port CO2
      purge closed. No supervisory host takes part.
    - the transfer and CIP peer status bits that plc-utilities reads
  Alarms (every bit in alarms.json for this PLC) are generated by
  plc/common/plcbuild.py at the ALARMS marker, with their deadbands and delays.

  Units: analog values are raw registers, engineering value x 10^scaling
  (degF x 100, psia x 100, vol x 100, % x 10). Setpoints in %MW belong to the
  operator after the first scan; the program loads defaults once and clamps.
*)

(* One glycol zone: cooling-only on/off valve with hysteresis. *)
FUNCTION_BLOCK GlycolZone
  VAR_INPUT
    PV : UINT;                 (* temperature, degF x 100 *)
    SP : UINT;                 (* setpoint, degF x 100 *)
    HYST : UINT := 50;         (* half band, 0.5 degF *)
  END_VAR
  VAR_OUTPUT
    VALVE : BOOL;              (* TRUE = open (cooling) *)
  END_VAR
  IF PV >= SP + HYST THEN
    VALVE := TRUE;
  ELSIF PV + HYST <= SP THEN
    VALVE := FALSE;
  END_IF;
END_FUNCTION_BLOCK

(* Carbonation for one bright tank. *)
FUNCTION_BLOCK Carbonation
  VAR_INPUT
    TEMP : UINT;               (* beer temperature, degF x 100 *)
    VOL_SP : UINT;             (* target, vol x 100 *)
    VOL_PV : UINT;             (* inline meter, vol x 100 *)
    INHIBIT : BOOL;            (* cellar CO2 interlock *)
  END_VAR
  VAR_OUTPUT
    PSIA_SP : UINT;            (* equilibrium head pressure, psia x 100 *)
    VALVE : UINT;              (* stone flow valve, % x 10 *)
  END_VAR
  VAR
    temp_f : REAL;
    vol : REAL;
    psig_sea_level : REAL;
    shortfall : REAL;
  END_VAR
  temp_f := UINT_TO_REAL(TEMP) / 100.0;
  vol := UINT_TO_REAL(VOL_SP) / 100.0;
  psig_sea_level := -16.6999 - 0.0101059 * temp_f + 0.00116512 * temp_f * temp_f
    + 0.173354 * temp_f * vol + 4.24267 * vol - 0.0684226 * vol * vol;
  PSIA_SP := REAL_TO_UINT(LIMIT(0.0, (psig_sea_level + 14.7) * 100.0, 4000.0));
  (* 100 % at 0.5 vol or more short of the target, closed at the target. *)
  shortfall := (UINT_TO_REAL(VOL_SP) - UINT_TO_REAL(VOL_PV)) / 100.0;
  IF INHIBIT OR shortfall <= 0.0 THEN
    VALVE := 0;
  ELSE
    VALVE := REAL_TO_UINT(LIMIT(0.0, shortfall * 2000.0, 1000.0));
  END_IF;
END_FUNCTION_BLOCK

PROGRAM plc_cellar
  (* LOCATED_VARS: plcbuild.py splices the located variables and alarm instances here. *)

  VAR CONSTANT
    TEMP_SP_MIN : UINT := 2000;       (* 20 degF *)
    TEMP_SP_MAX : UINT := 9000;       (* 90 degF *)
    VOL_SP_MAX : UINT := 350;         (* 3.5 vol *)
    AMBIENT_PSIA : UINT := 1210;      (* 12.1 psia at 5,200 ft *)
    SPUND_LOW_PSIG : UINT := 100;     (* 1 psig while fermenting *)
    SPUND_HIGH_PSIG : UINT := 1200;   (* 12 psig near terminal gravity *)
    TERMINAL_PLATO : UINT := 500;     (* 5 degP *)
    BBT_FEED_MIN_LEVEL : UINT := 50;  (* 5 % *)
    CO2_RELEASE_DELAY : TIME := T#60s;  (* relay must be healthy this long *)
  END_VAR

  VAR
    started : BOOL := FALSE;
    fv101_side : GlycolZone;
    fv101_cone : GlycolZone;
    fv102_side : GlycolZone;
    fv102_cone : GlycolZone;
    fv103_side : GlycolZone;
    fv103_cone : GlycolZone;
    fv104_side : GlycolZone;
    fv104_cone : GlycolZone;
    bbt201_zone : GlycolZone;
    bbt202_zone : GlycolZone;
    bbt201_carb : Carbonation;
    bbt202_carb : Carbonation;
    co2_healthy : TON;
    transfer_active : BOOL;
  END_VAR

  (* First scan: default setpoints for the staggered initial state (DESIGN.md 9.4). *)
  IF NOT started THEN
    CEL_FV101_TT01_SP := 6600;
    CEL_FV101_TT02_SP := 6600;
    CEL_FV102_TT01_SP := 6600;
    CEL_FV102_TT02_SP := 6600;
    CEL_FV103_TT01_SP := 6800;
    CEL_FV103_TT02_SP := 6800;
    CEL_FV104_TT01_SP := 3400;
    CEL_FV104_TT02_SP := 3400;
    CEL_BBT201_TT01_SP := 3400;
    CEL_BBT202_TT01_SP := 3400;
    CEL_BBT201_AT01_SP := 260;
    CEL_BBT202_AT01_SP := 260;
    started := TRUE;
  END_IF;

  CEL_FV101_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV101_TT01_SP, TEMP_SP_MAX);
  CEL_FV101_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV101_TT02_SP, TEMP_SP_MAX);
  CEL_FV102_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV102_TT01_SP, TEMP_SP_MAX);
  CEL_FV102_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV102_TT02_SP, TEMP_SP_MAX);
  CEL_FV103_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV103_TT01_SP, TEMP_SP_MAX);
  CEL_FV103_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV103_TT02_SP, TEMP_SP_MAX);
  CEL_FV104_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_FV104_TT01_SP, TEMP_SP_MAX);
  CEL_FV104_TT02_SP := LIMIT(TEMP_SP_MIN, CEL_FV104_TT02_SP, TEMP_SP_MAX);
  CEL_BBT201_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_BBT201_TT01_SP, TEMP_SP_MAX);
  CEL_BBT202_TT01_SP := LIMIT(TEMP_SP_MIN, CEL_BBT202_TT01_SP, TEMP_SP_MAX);
  CEL_BBT201_AT01_SP := MIN(CEL_BBT201_AT01_SP, VOL_SP_MAX);
  CEL_BBT202_AT01_SP := MIN(CEL_BBT202_AT01_SP, VOL_SP_MAX);

  (* ---- CO2 life-safety interlock (DESIGN.md 6.7) ---------------------------- *)
  (* The relay is de-energize to trip: open (FALSE) inhibits at once, and the
     inhibit clears only after the relay has been healthy for CO2_RELEASE_DELAY. *)
  co2_healthy(IN := CEL_SYS_XS01_CO2_OK, PT := CO2_RELEASE_DELAY);
  CEL_SYS_XS01_CO2_INHIBIT := NOT co2_healthy.Q;

  (* ---- fermenters --------------------------------------------------------------- *)
  fv101_side(PV := CEL_FV101_TT01_PV, SP := CEL_FV101_TT01_SP);
  CEL_FV101_TV01_CMD := fv101_side.VALVE;
  fv101_cone(PV := CEL_FV101_TT02_PV, SP := CEL_FV101_TT02_SP);
  CEL_FV101_TV02_CMD := fv101_cone.VALVE;
  IF CEL_FV101_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV101_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV101_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  fv102_side(PV := CEL_FV102_TT01_PV, SP := CEL_FV102_TT01_SP);
  CEL_FV102_TV01_CMD := fv102_side.VALVE;
  fv102_cone(PV := CEL_FV102_TT02_PV, SP := CEL_FV102_TT02_SP);
  CEL_FV102_TV02_CMD := fv102_cone.VALVE;
  IF CEL_FV102_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV102_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV102_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  fv103_side(PV := CEL_FV103_TT01_PV, SP := CEL_FV103_TT01_SP);
  CEL_FV103_TV01_CMD := fv103_side.VALVE;
  fv103_cone(PV := CEL_FV103_TT02_PV, SP := CEL_FV103_TT02_SP);
  CEL_FV103_TV02_CMD := fv103_cone.VALVE;
  IF CEL_FV103_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV103_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV103_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  fv104_side(PV := CEL_FV104_TT01_PV, SP := CEL_FV104_TT01_SP);
  CEL_FV104_TV01_CMD := fv104_side.VALVE;
  fv104_cone(PV := CEL_FV104_TT02_PV, SP := CEL_FV104_TT02_SP);
  CEL_FV104_TV02_CMD := fv104_cone.VALVE;
  IF CEL_FV104_DT01_PV < TERMINAL_PLATO THEN
    CEL_FV104_PCV01_SP := SPUND_HIGH_PSIG + AMBIENT_PSIA;
  ELSE
    CEL_FV104_PCV01_SP := SPUND_LOW_PSIG + AMBIENT_PSIA;
  END_IF;

  (* ---- bright tanks --------------------------------------------------------------- *)
  bbt201_zone(PV := CEL_BBT201_TT01_PV, SP := CEL_BBT201_TT01_SP);
  CEL_BBT201_TV01_CMD := bbt201_zone.VALVE;
  bbt201_carb(TEMP := CEL_BBT201_TT01_PV, VOL_SP := CEL_BBT201_AT01_SP,
    VOL_PV := CEL_BBT201_AT01_PV, INHIBIT := CEL_SYS_XS01_CO2_INHIBIT);
  CEL_BBT201_PT01_SP := bbt201_carb.PSIA_SP;
  CEL_BBT201_FCV01_OUT := bbt201_carb.VALVE;
  CEL_BBT201_XV01_CMD := FALSE;  (* BBT-201 is carbonating, not feeding *)

  bbt202_zone(PV := CEL_BBT202_TT01_PV, SP := CEL_BBT202_TT01_SP);
  CEL_BBT202_TV01_CMD := bbt202_zone.VALVE;
  bbt202_carb(TEMP := CEL_BBT202_TT01_PV, VOL_SP := CEL_BBT202_AT01_SP,
    VOL_PV := CEL_BBT202_AT01_PV, INHIBIT := CEL_SYS_XS01_CO2_INHIBIT);
  CEL_BBT202_PT01_SP := bbt202_carb.PSIA_SP;
  CEL_BBT202_FCV01_OUT := bbt202_carb.VALVE;
  CEL_BBT202_XV01_CMD := CEL_BBT202_LT01_PV > BBT_FEED_MIN_LEVEL;

  (* ---- dry-hop doser: both valves closed until a dose sequence is commanded.
     The CO2 interlock keeps the purge closed regardless. *)
  CEL_DH_XV01_CMD := FALSE AND NOT CEL_SYS_XS01_CO2_INHIBIT;
  CEL_DH_XV02_CMD := FALSE;

  (* ---- transfer panel and the peer status for plc-utilities (DESIGN.md 6.6 #4) *)
  CEL_XFER_HS01_CMD := FALSE;
  transfer_active := CEL_XFER_YS01_PV OR CEL_XFER_HS01_CMD;
  CEL_XFER_XS01_ACTIVE := transfer_active;
  CEL_XFER_XS02_CIP_PERMIT := NOT transfer_active;

  (* ALARMS: plcbuild.py generates the alarm logic here. *)
END_PROGRAM
