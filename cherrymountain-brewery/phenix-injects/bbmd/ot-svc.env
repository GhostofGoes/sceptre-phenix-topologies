# Settings for cm-bbmd.service on ot-svc, the OPS BBMD (DESIGN.md 10.4).
# The /0 prefix makes the broadcast address 255.255.255.255, which is where
# FUXA's node-bacnet sends its Who-Is. The BDT lists both BBMDs, without masks,
# so each side unicasts to the other.
CM_BBMD_NAME=bbmd-ops
CM_BBMD_INSTANCE=9001
CM_BBMD_ADDRESS=10.20.30.13/0:47808
CM_BBMD_BDT=10.20.30.13:47808,10.30.10.5:47808
