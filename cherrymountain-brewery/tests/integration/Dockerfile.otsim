# ot-sim for the ci slice integration test (Ubuntu 24.04, "noble").
#
# Builds only what a Modbus remote I/O host needs: the C message bus, the Go
# cpu, modbus, and logic modules, and the Python modules (the HELICS I/O module).
# The C++ DNP3 module is skipped because rio-cellar speaks Modbus only; it is
# also the part whose build downloads GitHub release archives. The full image
# recipe (DNP3 included) is spikes/otsim-noble/Dockerfile.noble.
#
# pyzmq is rebuilt from source so it links the system libzmq: the I/O module
# crashes on noble when pyzmq's bundled libzmq sits next to HELICS's own
# (spikes/otsim-noble/README.md).
#
#   docker build -f Dockerfile.otsim -t cm-otsim:noble tests/integration
ARG BASE=ubuntu:24.04
FROM ${BASE}
ARG OTSIM_REF=9dc33047ff9fb474e61c8931c7dac7bf98df38ef
ENV DEBIAN_FRONTEND=noninteractive
# The base image tag is the pin; noble's apt versions move with security fixes.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates libczmq-dev libxml2-dev libzmq5-dev \
      pkg-config python3-dev python3-pip python3-venv golang-go \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/patsec/ot-sim.git /usr/local/src/ot-sim \
    && git -C /usr/local/src/ot-sim checkout "${OTSIM_REF}"
WORKDIR /usr/local/src/ot-sim
RUN cmake -S src/c -B build-c && cmake --build build-c -j"$(nproc)" && cmake --install build-c \
    && make -C src/go bin/ot-sim-cpu-module bin/ot-sim-modbus-module bin/ot-sim-logic-module \
    && install -m 0755 src/go/bin/ot-sim-cpu-module src/go/bin/ot-sim-modbus-module src/go/bin/ot-sim-logic-module /usr/local/bin/
RUN python3 -m venv /opt/otsim-venv \
    && /opt/otsim-venv/bin/pip install --no-cache-dir /usr/local/src/ot-sim/src/python pydantic \
    && /opt/otsim-venv/bin/pip install --no-cache-dir --force-reinstall --no-deps \
         --no-binary pyzmq pyzmq
ENV PATH=/opt/otsim-venv/bin:${PATH}
WORKDIR /opt/cm
CMD ["sleep", "infinity"]
