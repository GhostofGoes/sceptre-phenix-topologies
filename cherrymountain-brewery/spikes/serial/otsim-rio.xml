<?xml version="1.0"?>
<!-- rio-utilities: an ot-sim Modbus RTU master on the phenix serial app's pty, polling the
     chiller every second, and a loopback TCP server that shows what it read (and takes a write
     that the master forwards over the serial link). -->
<ot-sim>
  <message-bus>
    <pull-endpoint>tcp://127.0.0.1:1234</pull-endpoint>
    <pub-endpoint>tcp://127.0.0.1:5678</pub-endpoint>
  </message-bus>
  <cpu>
    <module name="backplane">ot-sim-message-bus {{config_file}}</module>
    <module name="modbus">ot-sim-modbus-module {{config_file}}</module>
  </cpu>
  <modbus name="rio-master" mode="client">
    <unit-id>1</unit-id>
    <period>1s</period>
    <serial>
      <device>/dev/ttyS10</device>
      <baud-rate>9600</baud-rate>
      <timeout>2s</timeout>
    </serial>
    <register type="input">
      <address>30000</address>
      <tag>chiller.temp</tag>
    </register>
    <register type="holding">
      <address>40000</address>
      <tag>chiller.setpoint</tag>
    </register>
  </modbus>
  <modbus name="rio-view" mode="server">
    <id>1</id>
    <endpoint>127.0.0.1:5502</endpoint>
    <register type="input">
      <address>30000</address>
      <tag>chiller.temp</tag>
    </register>
    <register type="holding">
      <address>40000</address>
      <tag>chiller.setpoint</tag>
    </register>
  </modbus>
</ot-sim>
