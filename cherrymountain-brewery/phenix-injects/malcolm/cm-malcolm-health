#!/bin/bash
# Health of the Malcolm sensor, for SoH custom tests and SCORCH `cc` checks
# (DESIGN.md 15.4 and 15.6: "Malcolm Zeek logs growing"). Installed as
# /usr/local/sbin/cm-malcolm-health. Run as root or as a member of the docker group.
#
# Prints one line, `HEALTHY` or `UNHEALTHY: <reason>`, and exits 0 or 1:
#   - every container of the profile is running (the compose services, minus the
#     one-shot ones), and none reports its Docker healthcheck unhealthy,
#   - the capture port is up for capture: the in-guest OVS port (`phenix`) is in
#     promiscuous mode and its rx packet count grows over a short interval (the
#     mirror delivers frames), and
#   - OpenSearch holds Zeek records from the last 15 minutes. The plant polls
#     Modbus several times a second, so a live capture always has some.
# CM_HEALTH_WINDOW (minutes, default 15) changes the window, CM_CAPTURE_IFACE
# (default phenix) the capture port, and CM_CAPTURE_SAMPLE (seconds, default 3)
# the rx sample; CM_SYSFS_NET (default /sys/class/net) is for the tests.
set -uo pipefail

STATE="${CM_MALCOLM_STATE:-/var/lib/cm-malcolm}"
SRC="${CM_MALCOLM_SRC:-/opt/cherrymountain/malcolm}"
WINDOW="${CM_HEALTH_WINDOW:-15}"
IFACE="${CM_CAPTURE_IFACE:-phenix}"
SAMPLE="${CM_CAPTURE_SAMPLE:-3}"
SYSFS="${CM_SYSFS_NET:-/sys/class/net}"

# shellcheck source=phenix-injects/malcolm/profiles.sh
. "${SRC}/profiles.sh"

fail() {
  echo "UNHEALTHY: $*"
  exit 1
}

profile=$(cat "${STATE}/profile" 2> /dev/null) || fail "Malcolm is not provisioned (no ${STATE}/profile)"
# Running containers only, with their status ("Up 3 hours (unhealthy)").
running=$(docker ps --filter status=running --format '{{.Names}}|{{.Status}}' 2> /dev/null) || fail "docker does not answer"
read -r -a services <<< "opensearch $(cm_malcolm_services "$profile")"
for service in "${services[@]}"; do
  line=$(grep -m1 "^malcolm-${service}-1|" <<< "$running") || fail "container malcolm-${service}-1 is not running"
  case "$line" in
    *"(unhealthy)"*) fail "container malcolm-${service}-1 is unhealthy" ;;
  esac
done

# The capture port: promiscuous (IFF_PROMISC, 0x100, set while a capture
# process holds it) and receiving the mirrored frames.
[ -r "${SYSFS}/${IFACE}/flags" ] || fail "capture port ${IFACE} does not exist"
flags=$(cat "${SYSFS}/${IFACE}/flags")
(( flags & 0x100 )) || fail "capture port ${IFACE} is not in promiscuous mode"
rx1=$(cat "${SYSFS}/${IFACE}/statistics/rx_packets")
sleep "$SAMPLE"
rx2=$(cat "${SYSFS}/${IFACE}/statistics/rx_packets")
[ "$rx2" -gt "$rx1" ] || fail "capture port ${IFACE} received no packets in ${SAMPLE} s (mirror down?)"

query=$(printf '{"query":{"bool":{"filter":[{"term":{"event.provider":"zeek"}},{"range":{"@timestamp":{"gte":"now-%sm"}}}]}}}' "$WINDOW")
count=$(docker exec malcolm-opensearch-1 sh -c \
  "curl -sk -K /var/local/curlrc/.opensearch.primary.curlrc -H 'Content-Type: application/json' 'https://localhost:9200/arkime_sessions3-*/_count' -d '${query}'" 2> /dev/null \
  | python3 -c 'import json, sys; print(json.load(sys.stdin).get("count", 0))' 2> /dev/null) || fail "OpenSearch did not answer the count query"
if [ "${count:-0}" -le 0 ]; then
  fail "no Zeek records in the last ${WINDOW} minutes"
fi
echo "HEALTHY: profile ${profile}, $(( rx2 - rx1 )) packets on ${IFACE} in ${SAMPLE} s, ${count} Zeek records in the last ${WINDOW} minutes"
